# ============================================================================
# Henry's List — environment variables
# Copy this file to .env (local dev) and fill in real values.
# NEVER commit .env with real secrets.
# ============================================================================

# --- App -------------------------------------------------------------------
NODE_ENV=development
# Public base URL of the app (no trailing slash). Used for links in emails,
# absolute canonical URLs, sitemap, OG tags, and Stripe redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Display name of the marketplace, shown in UI/emails/meta tags.
NEXT_PUBLIC_SITE_NAME="Henry's List"

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string. Prisma reads this.
DATABASE_URL="postgresql://henryslist:henryslist_dev_pw@localhost:5432/henryslist?schema=public"

# --- Auth (Auth.js / NextAuth v5) ------------------------------------------
# Random 32+ byte secret used to sign session/JWT cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true

# Google OAuth (optional but supported). Create credentials at
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple Sign-In (optional). https://developer.apple.com/account/resources/identifiers/list/serviceId
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# --- Stripe ------------------------------------------------------------------
# Secret key from https://dashboard.stripe.com/apikeys (test mode: sk_test_...)
STRIPE_SECRET_KEY=sk_test_replace_me
# Publishable key, safe to expose to the browser (pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Webhook signing secret from `stripe listen` (local) or the Dashboard
# webhook endpoint config (production): https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Email (transactional) --------------------------------------------------
# Provider: "smtp" (generic, works with any SMTP host, incl. Resend's SMTP
# relay) or "resend" (Resend HTTP API). "console" just logs emails — good
# default for local dev with no provider configured.
EMAIL_PROVIDER=console
EMAIL_FROM="Henry's List <notifications@henryslist.example>"

# Used when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Used when EMAIL_PROVIDER=resend
RESEND_API_KEY=

# --- File storage ------------------------------------------------------------
# Provider: "local" (disk, good for dev/single-server) or "s3"
# (S3-compatible object storage — AWS S3, Cloudflare R2, Backblaze B2, etc.)
STORAGE_PROVIDER=local
# Local storage: absolute or relative path where uploads are written. Must be
# served by the app (see src/app/api/uploads/[...path]/route.ts) or mapped to
# a public directory / reverse proxy in production.
LOCAL_STORAGE_DIR=./public/uploads
LOCAL_STORAGE_PUBLIC_PATH=/uploads

# S3-compatible storage config (used when STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL to read objects back (CDN or bucket public URL)
S3_PUBLIC_URL=

# --- Background jobs / cron --------------------------------------------------
# Shared secret required as a Bearer token or ?secret= query param on
# /api/cron/* routes, so only your scheduler (Vercel Cron, GitHub Actions,
# system crontab calling curl, etc.) can trigger them.
CRON_SECRET=replace-with-a-long-random-secret

# --- Business rules (admin-configurable defaults) ---------------------------
# These seed the PlatformSetting table on first run; after that, change them
# from the admin dashboard (Settings) rather than here.
DEFAULT_LISTING_PRICE_CENTS=100
DEFAULT_LISTING_DURATION_DAYS=45

# --- Rate limiting / abuse prevention ----------------------------------------
# Optional Upstash Redis for distributed rate limiting. If unset, the app
# falls back to an in-memory limiter (fine for a single instance/dev, NOT
# sufficient for a multi-instance production deployment).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional hCaptcha/Turnstile keys for bot protection on signup/posting.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Push notifications (optional, Web Push) --------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
