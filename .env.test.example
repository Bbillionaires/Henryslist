# Environment for `npm test` (Vitest). Copy to .env.test and point
# DATABASE_URL at a disposable database — the integration tests TRUNCATE
# every table between tests (see src/test-utils/db.ts), so never point this
# at a database with real data.
#
#   createdb henryslist_test
#   DATABASE_URL="postgresql://user:pass@localhost:5432/henryslist_test" \
#     npx prisma migrate deploy
#
# Everything else can stay as placeholders — the test suite never calls
# Stripe or a real email provider (EMAIL_PROVIDER=console just logs).

DATABASE_URL="postgresql://henryslist:henryslist_dev_pw@localhost:5432/henryslist_test?schema=public"
AUTH_SECRET=test-only-secret-not-used-for-anything-real
AUTH_TRUST_HOST=true
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
EMAIL_PROVIDER=console
EMAIL_FROM="Henry's List <notifications@henryslist.example>"
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./public/uploads
LOCAL_STORAGE_PUBLIC_PATH=/uploads
CRON_SECRET=test-only-secret-not-used-for-anything-real
DEFAULT_LISTING_PRICE_CENTS=100
DEFAULT_LISTING_DURATION_DAYS=45
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Henry's List"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
